# Public client config (safe to ship in the app — anon key is RLS-gated).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Stream Chat (public app key only — token minting happens in an Edge Function).
EXPO_PUBLIC_STREAM_API_KEY=

# RevenueCat public SDK keys (per platform).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# -----------------------------------------------------------------------------
# SECRETS BELOW — never bundled in the app. Set these in Supabase Edge Function
# secrets (`supabase secrets set ...`), not in the Expo client.
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STREAM_API_SECRET=
# AWS_REKOGNITION_ACCESS_KEY_ID=
# AWS_REKOGNITION_SECRET_ACCESS_KEY=
# HIVE_API_KEY=
# NCMEC_REPORTING_ENDPOINT=
